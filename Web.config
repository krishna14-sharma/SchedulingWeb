<?xml version="1.0" encoding="utf-8"?>
<!--
  Phoenix Scheduling - ASP.NET Web Forms 4.8 (Web Site model, VB.NET)
  Open in Visual Studio with: File > Open > Web Site...  (or point an IIS site / application at this folder)
-->
<configuration>

  <connectionStrings>
    <!-- Same database the WinForms app used (GMod.Connstr). Move this into an encrypted section or use a
         dedicated low-privilege SQL login before going live. -->
    <add name="PhxGroupERP"
         connectionString="Data Source=137.97.174.50,3759;Initial Catalog=PhxGroupERP;User ID=sa;Password=Ph@hoenix#g;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- GMod.Cmpid was never assigned in the WinForms app, so it was always an empty string. Kept the same. -->
    <add key="CmpId" value="" />

    <!-- Menu: Layer Schedule > Layer Schedule (opened this URL in the browser) -->
    <add key="LayerScheduleUrl" value="http://137.97.174.50:5008" />

    <!-- Report: Layer Placement Tentative Date read this fixed head table in the WinForms app -->
    <add key="LayerTentativeHeadTable" value="ACC_HEAD_PHHA_2425" />

    <!-- Consolidate Schedule Report > Send Mail -->
    <add key="Mail.SmtpHost" value="smtp.gmail.com" />
    <add key="Mail.SmtpPort" value="587" />
    <add key="Mail.EnableSsl" value="true" />
    <add key="Mail.User" value="krishna@phoenixgrp.co.in" />
    <add key="Mail.Password" value="dull oehf gtdo dfpr" />
    <add key="Mail.From" value="krishna@phoenixgrp.co.in" />
    <add key="Mail.To" value="pallab@phoenixgrp.co.in" />
    <add key="Mail.Bcc" value="gdubey@phoenixgrp.co.in" />
    <add key="Mail.Subject" value="Schedule Hatchery Wise Report" />

    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" maxRequestLength="20480" enableVersionHeader="false" />
    <sessionState mode="InProc" timeout="120" cookieName="PhxSchedSession" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Login.aspx" />
    <globalization culture="en-IN" uiCulture="en-IN" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <pages clientIDMode="Static" controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="System.Data" />
        <add namespace="System.Web.Services" />
      </namespaces>
    </pages>
    <httpCookies httpOnlyCookies="true" />
  </system.web>

  <system.web.extensions>
    <scripting>
      <webServices>
        <!-- Reports can return thousands of rows -->
        <jsonSerialization maxJsonLength="50000000" />
      </webServices>
    </scripting>
  </system.web.extensions>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Dashboard.aspx" />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>
